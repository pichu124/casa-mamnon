{
  "name": "casa-mamnon",
  "version": "0.1.0",
  "description": "CASA Mầm non - Liên lạc nhà trường và gia đình cho trường mầm non 3 cơ sở",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "seed": "node data/seed.js --force",
    "mobile:prepare": "node scripts/prepare-mobile.js",
    "mobile:sync": "npx cap sync android",
    "mobile:icons": "npx @capacitor/assets generate --android --iconBackgroundColor '#4f46e5' --splashBackgroundColor '#4f46e5' --splashBackgroundColorDark '#0a0e1a'",
    "mobile:apk": "cd android && ./gradlew assembleDebug",
    "migrate": "node scripts/migrate-json-to-sqlite.js",
    "backup": "node scripts/backup.js",
    "backup:list": "node scripts/backup.js --list",
    "restore": "node scripts/restore.js",
    "restore:check": "node scripts/restore.js --kiem-tra",
    "create-admin": "node scripts/create-admin.js",
    "tai-lieu:quy-trinh": "node scripts/xuat-quy-trinh.js",
    "prepare": "node scripts/cai-hook.js",
    "test": "node test/du-lieu.test.mjs && node test/khe-uoc.test.mjs && node test/commit-rieng.test.mjs && node test/kiem-tra-may-chu.test.mjs && node test/lo-hong-da-va.test.mjs && node test/api.test.mjs && node test/bien-soan.test.mjs && node test/bao-mat.test.mjs && node test/mat-khau.test.mjs && node test/quan-tri.test.mjs && node test/nam-hoc.test.mjs && node test/nhom-lop.test.mjs && node test/goi-ten.test.mjs && node test/quy-tac-4.test.mjs && node test/tinh-nang.test.mjs && node test/thuchup.test.mjs && node test/co-lap-loi.test.mjs && node test/luoi-an-toan.test.mjs",
    "test:commit-rieng": "node scripts/kiem-tra-commit.js",
    "test:quet-kho": "node scripts/kiem-tra-du-lieu.js --quet-kho",
    "test:du-lieu": "node scripts/kiem-tra-du-lieu.js",
    "kiem-tra-may-chu": "node scripts/kiem-tra-may-chu.js",
    "sua-quyen-chu-nhiem": "node scripts/sua-quyen-chu-nhiem.js",
    "test:may-chu": "node test/kiem-tra-may-chu.test.mjs",
    "test:lo-hong": "node test/lo-hong-da-va.test.mjs",
    "test:du-lieu-kiemthu": "node test/du-lieu.test.mjs",
    "test:commit-rieng-kiemthu": "node test/commit-rieng.test.mjs",
    "test:tinh-nang": "node test/tinh-nang.test.mjs",
    "test:khe-uoc": "node test/khe-uoc.test.mjs",
    "test:api": "node test/api.test.mjs",
    "test:bien-soan": "node test/bien-soan.test.mjs",
    "test:bao-mat": "node test/bao-mat.test.mjs",
    "test:mat-khau": "node test/mat-khau.test.mjs",
    "test:quan-tri": "node test/quan-tri.test.mjs",
    "test:nam-hoc": "node test/nam-hoc.test.mjs",
    "test:nhom-lop": "node test/nhom-lop.test.mjs",
    "test:goi-ten": "node test/goi-ten.test.mjs",
    "test:quy-tac-4": "node test/quy-tac-4.test.mjs",
    "test:co-lap-loi": "node test/co-lap-loi.test.mjs",
    "test:luoi-an-toan": "node test/luoi-an-toan.test.mjs",
    "test:album": "node test/album.test.mjs",
    "test:pwa": "node test/pwa.test.mjs",
    "test:thuchup": "node test/thuchup.test.mjs",
    "test:giao-dien": "node test/album.test.mjs && node test/pwa.test.mjs && node test/tinh-nang-giao-dien.test.mjs && node test/bien-soan-giao-dien.test.mjs",
    "test:tat-ca": "npm test && npm run test:giao-dien"
  },
  "engines": {
    "node": "22.x"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "better-sqlite3": "12.11.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "playwright": "^1.62.1",
    "docx": "^9.5.0"
  }
}
