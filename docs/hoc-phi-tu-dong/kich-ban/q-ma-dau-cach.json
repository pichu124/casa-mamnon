 "ghi_chu": {
  "BE01": "đối chứng cạnh \"BE01 \": hai mã khác nhau nên KHÔNG trùng; dòng gán ma_be \"BE01 \" không thuộc bé này; cũng kiểm MAM không bị dòng \"MAM \" (01/11) đẩy giá T11–T12 lên 6.000.000",
  "BE01 ": "mã bé có dấu cách cuối → LỖI (1.2/10), chỉ chặn bé này",
  " BE02": "mã bé có dấu cách đầu → LỖI",
  "BE02": "đối chứng cạnh \" BE02\": không trùng, không nhận dòng gán của \" BE02\"",
  "be10 ": "hoa/thường khác + dấu cách cuối: không trùng với BE10, bị chặn vì dấu cách",
  "BE 03": "dấu cách giữa → hợp lệ",
  "BE  06": "hai dấu cách liền ở giữa, không có ở đầu/cuối → hợp lệ (ma ≠ TRIM(ma) không phải phép thử đúng)",
  "12 3": "bỏ dấu cách hai đầu vẫn còn dấu cách giữa → không \"chỉ gồm chữ số\" → mã hợp lệ",
  " 123 ": "mã dạng số và có dấu cách đầu/cuối → LỖI",
  "BE04": "đối chứng cạnh \"BE04\\u00a0\" — khác mã, không trùng; không nhận dòng gán của bé kia",
  "BE04 ": "NBSP cuối KHÔNG phải dấu cách → mã hợp lệ; nhận CU_DAN 5%",
  "BE05": "đối chứng cạnh \"BE05\\t\"",
  "BE05\t": "tab cuối KHÔNG phải dấu cách → mã hợp lệ; nhận GIAM 10%",
  " BE14": "NBSP đầu → mã hợp lệ",
  "BE07": "dòng gán ma_be \"BE07 \" không khớp bé nào → CU_DAN KHÔNG áp cho BE07",
  "BE08": "dòng gán ma_be \"BE08 \" với mã ưu đãi không có trong danh mục: dòng không thuộc bé nào → không chặn BE08",
  "BE09": "dòng gán ma_be \" BE09\" không khớp → không áp",
  "GS1": "gói \"MAM \": dòng duy nhất khớp là dòng lỗi → chặn",
  "GS2": "khớp \"MAM \" không phân biệt hoa/thường → dòng lỗi → chặn",
  "GS3": "chưa đến kỳ (N = 11/2027 > THANG_THU) nhưng gói có dòng lỗi vẫn là LỖI → chặn (bản cũ: tính được, 0 đ)",
  "GS4": "tham chiếu \" MAM\" không khớp gói nào → LỖI \"không có trong biểu phí\"",
  "GS5": "MAM 12 tháng: T10–T12/2027 5.000.000, T1–T9/2028 5.500.000; dòng \"MAM \" 01/11 KHÔNG xen vào",
  "GM1": "gói mới \"MAM \" có dòng lỗi → chặn (bản cũ: 17.000.000)",
  "GM2": "T10 MAM 5.000.000 + T11–T12 \"MAM 2\" 4.000.000",
  "GM3": "gói mới có dòng lỗi chặn bé dù ngày đổi ngoài kỳ",
  "NHA1": "\" NHA\" cùng tháng bắt đầu (trống) nhưng khác mã → KHÔNG trùng; NHA vẫn tính",
  "M2C": "hai dấu cách giữa không khớp \"MAM 2\" → không có trong biểu phí",
  "M3B": "một dấu cách không khớp \"MAM  3\" (không gộp dấu cách như TRIM)",
  "QD2A": "QĐ \"QD2 \" là dòng lỗi → chặn",
  "QD2B": "\"QD2\" không có (chỉ có \"QD2 \") → chặn",
  "QD3A": "\" QD3\" là dòng lỗi riêng, KHÔNG làm QD3 thành mã trùng; QD3 mốc 1 = 36 tháng → T10–T12 mốc 1 → NAM_DAU 10%",
  "QD5A": "\"QD5\\u00a0\" mốc 1 = 12 tháng → mốc 2 → NAM_DAU không áp",
  "QD5B": "\"QD5\" mốc 1 = 36 tháng → NAM_DAU 10%",
  "QD1S": "tham chiếu \"QD1 \" không khớp → chặn",
  "UD1": "\" GIAM\" là mục lỗi riêng, KHÔNG làm GIAM thành mã trùng → GIAM 10%",
  "UD2": "dòng gán \" GIAM\" khớp mục lỗi → chặn",
  "UD3": "dòng gán \"UD_X \" khớp mục lỗi → chặn",
  "UD4": "\"UD_X\" không có trong danh mục → chặn",
  "UD5": "dòng gán \"UD_X \" ngoài cửa sổ vẫn chặn (mục lỗi chặn kể cả dòng ngoài cửa sổ) — bản cũ: 15.000.000",
  "UD6": "dòng gán \"CU_DAN \" không có trong danh mục → chặn",
  "UD9": "\"UU\\u00a0\" 8% — khác mã \"UU\" 12%",
  "TAT CA": "\"MAM 2\" 4.000.000 × 95% (CU DAN) × 3",
  "GV2": "không phân biệt hoa/thường",
  "GV4": "\"Có \" ≠ \"Có\" (không bỏ khoảng trắng) → Quý",
  "GV6": "\"Có\" dạng tổ hợp NFD (o + U+0301): khác chuỗi \"Có\" NFC — đặc tả không chuẩn hoá Unicode → Quý (nếu bản cài so kiểu ngôn ngữ/collation thì sẽ coi bằng nhau — xem ghi chú khe đặc tả)"
 }
