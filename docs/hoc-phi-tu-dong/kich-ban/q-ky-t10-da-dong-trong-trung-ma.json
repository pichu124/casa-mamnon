 "ghi_chu": {
  "T01": "bé mới nhập học đúng tháng thu, ô trống → N = tháng nhập học",
  "T02": "bé mới 09/2027: kỳ lẻ 09 gộp với Q4 → 4 tháng",
  "T03": "ví dụ trong đặc tả: 12T vào 08/2027 → 08/2027–09/2028 = 14 tháng",
  "T03B": "14 tháng: NAM1 (Mốc 1, 10%) cho 12 tháng đầu; CU_DAN từ 01/08/2028 chỉ ở tháng 13–14 (mốc 2 từ 08/2028) → 12×4.500.000 + 2×4.750.000",
  "T05": "kỳ lẻ 06 + 12 tháng = 13",
  "T06": "Quý từ 10/2026, ô trống → 15 tháng = đúng sức chứa",
  "T07": "Quý từ 09/2026 → 16 tháng > 15 → LỖI",
  "T08": "14 tháng",
  "T09": "6T: kỳ lẻ 11–12/2026, rồi 01–06, 07–12/2027 → 14",
  "T09B": "6T: kỳ lẻ 02–03/2027, 04–09, 10/2027–03/2028 → 14",
  "T10": "6T từ 10/2026: kỳ 10/2026–03/2027, 04–09, 10/2027–03/2028 → 18 → LỖI",
  "T11": "1 tháng con GV, 08/2026–10/2027 = 15",
  "T12": "16 tháng → LỖI",
  "T13": "bé cũ quên ghi ô → nợ từ 09/2025 → quá 15 tháng → LỖI (G22)",
  "T13B": "bé vào 04/2027 quên ghi ô → thu 04–12/2027 (9 tháng)",
  "T13C": "bé cũ đã nghỉ 05/2026, ô trống → nợ 09/2025–05/2026 = 9 tháng; E cắt theo ngày nghỉ",
  "T13D": "như T13C nhưng nghỉ 01/2027 → 17 tháng → LỖI",
  "T14": "Chưa nhập học; ky_den = E1 (kỳ lẻ tới hết Q4)",
  "T17": "đã đóng đến TRƯỚC ngày nhập học → N = tháng nhập học 12/2027",
  "T18B": "chưa đến kỳ: E = MIN(E1, tháng nghỉ)",
  "T18C": "nghỉ trước cả tháng nhập học → E < N → ky_den null",
  "T19": "nghỉ trước N, đã đóng tới sau tháng nghỉ → Đã nghỉ học, đóng dư (LƯU Ý)",
  "T20": "nghỉ ngày 1 tháng thu → vẫn thu trọn tháng (G15)",
  "T21": "nghỉ trong tháng đã đóng cuối → E < N",
  "T22": "bé mới đã nghỉ, ô trống → vẫn nợ 08–09/2027",
  "T24": "như T07 (16 tháng) nhưng nghỉ 11/2027 kéo về đúng 15 → tính được",
  "T28": "7 dòng CU_DAN, dòng 7 từ 01/01/2028 > cuối(E)=31/12/2027 → ngoài cửa sổ → chỉ 6 dòng → tính được (bản 2 là LỖI)",
  "T29": "như T28 nhưng dòng 7 từ 31/12/2027 → trong cửa sổ → 7 dòng → LỖI",
  "T28C": "kỳ 14 tháng; dòng 7 từ 01/10/2028 > E=09/2028 → ngoài cửa sổ",
  "T28D": "dòng 7 từ 30/09/2028 — trong tháng 14 của kỳ → LỖI",
  "T30": "E < N (cửa sổ \"rỗng\" theo 3.4) nhưng 7 dòng không hạn thỏa công thức 6.4 (tu ≤ cuối(E) và den ≥ đầu(N)) — đặc tả tự mâu thuẫn, không ghi ky_vong",
  "T31": "chưa đến kỳ (N > THANG_THU) với 7 dòng trong [N, E1] — mục 10 không nói lỗi sức chứa có cần \"đến kỳ\" không; không ghi ky_vong",
  "T32": "E < N nhưng dòng gán có p \"5%\" → lỗi dòng xét MỌI dòng",
  "R01": "5% tới 15/11, 7% từ 16/11 → T10 5%, T11 5% (mức cũ), T12 7%",
  "R02": "R01 nhập ngược thứ tự — không đổi",
  "R03": "đổi đúng ranh tháng 31/10 | 01/11",
  "R04": "chồng 1 ngày 01/11 → T11 giữ mức cũ",
  "R05": "hai dòng y hệt → chỉ một 5%, không lũy tiến",
  "R06": "cùng tu → dòng nhập SAU (7%)",
  "R07": "R06 đảo thứ tự → dòng nhập sau là 5%",
  "R08": "tu trống = 01/01/1900 = tu ghi rõ 1900-01-01 → bằng nhau → dòng sau (5%)",
  "R09": "R01 với mã khác hoa/thường",
  "R10": "CU_DAN 5%→12% từ 16/11 + KHAC 10%, số lượng 2: T11 khử trùng trước → 5%+10%; T12 12%+10%=20,8% → trần 20%",
  "R11": "R10 + THEM 8%: T11 sau khử trùng còn 5/10/8 → giữ 10+8; chọn trước rồi khử sẽ ra 12+10",
  "R12": "nhóm RIÊNG cùng mã 3%→6% từ 16/11",
  "R13": "hai dòng RIÊNG y hệt",
  "R14": "dòng cũ hết 30/09 (ngoài cửa sổ) → 7% cả kỳ",
  "R15": "đổi giữa tháng đầu kỳ",
  "R16": "ba mức 5→7→9: T10 5, T11 7, T12 9",
