  "Z04B": "2100 không nhuận",
  "Z04D": "kỳ tính ra kết thúc 09/2101 — chỉ ô NHẬP bị giới hạn 2100",
  "Z06": "đóng tới 01/1900 hợp lệ; N = MAX(02/1900, tháng nhập học)",
  "Z07": "chưa đến kỳ, kỳ kế tiếp 01–03/2101",
  "Z10": "nghỉ 01/1900 hợp lệ → E < N",
  "Z12": "nếu coi là hợp lệ thì y như không nghỉ — phải là LỖI",
  "Z14": "mốc 2 từ 01/1900 → NAM1 (Mốc 1) không áp",
  "Z15": "T10, T11 mốc 1 (NAM1 10%), T12 mốc 2",
  "Z16B": "đối chứng: không gia hạn → cả kỳ mốc 1",
  "Z23": "giá mới từ 12/2100",
  "Z23B": "T10, T11 chưa có giá",
  "Z24": "dòng 2101 lỗi → chặn cả gói, dù ngày sau kỳ",
  "Z24B": "29/02/2100 không có thật",
  "Z27": "chỉ T12 trùng",
  "Z28": "lỗi dù nằm ngoài cửa sổ",
  "Z30": "hợp lệ, ngoài cửa sổ",
  "Z33": "giá trị mặc định nội bộ nhưng GHI RÕ thì ngoài khoảng 1900–2100 → LỖI",
