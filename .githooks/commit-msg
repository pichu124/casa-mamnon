#!/bin/sh
# Chạy mỗi lần `git commit`, sau khi lời commit đã soạn xong.
# Xem lý do đầy đủ trong ba script bên dưới và trong CLAUDE.md.
DIR="$(dirname "$0")/.."

# 1. Không để dữ liệu thật của trường lọt lên kho mã. Không có đường thoát.
node "$DIR/scripts/kiem-tra-du-lieu.js" || exit 1

# 2. Sửa tệp dùng chung phải là commit riêng.
node "$DIR/scripts/kiem-tra-commit.js" --tin-nhan "$1" || exit 1

# 3. Đổi public/ thì phải tăng VERSION, nếu không máy đã cài app kẹt bản cũ.
node "$DIR/scripts/kiem-tra-sw.js" --tin-nhan "$1" || exit 1

# 4. Hướng dẫn thử gửi trường (docs/HUONG-DAN-*.md) chép từ bản chính trên claude.ai,
#    nơi người phụ trách điền mật khẩu thật. Bản đã `git add` mà có mật khẩu hay tên
#    người thì chặn: lên kho rồi là không thu lại được. Chỉ app 2 có bước này.
node "$DIR/scripts/xuat-huong-dan-thu.js" --kiem-tra --ban-sap-commit || exit 1
